# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only — never exposed to the browser. Used for privileged writes
# (e.g. logging risk_events / alert_calls) that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Feature 6 — LLM alert script generation. Get a free key at
# https://aistudio.google.com/apikey. Without it, simulateRiskEvent falls
# back to a canned (still Shadow-Clause-safe) script instead of erroring.
GEMINI_API_KEY=

# Feature 7 — real outbound alert call. Free trial at
# https://www.twilio.com/try-twilio (no card required). Trial accounts can
# only call numbers verified in the Twilio Console (Phone Numbers → Verified
# Caller IDs) — separate from this app's own "Confirmar número" flag.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
