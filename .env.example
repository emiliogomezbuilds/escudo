# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only — never exposed to the browser. Used for privileged writes
# (e.g. logging risk_events / alert_calls) that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Added in a later feature (LLM alert script generation)
GEMINI_API_KEY=

# Added in a later feature (real outbound alert call)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
